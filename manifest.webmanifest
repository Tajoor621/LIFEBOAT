{
  "id": "/LIFEBOAT/",
  "name": "LIFEBOAT — Backup, Recover, Be Ready",
  "short_name": "LIFEBOAT",
  "description": "Owner-controlled backup, recovery and loss response. Prepare before device loss, understand what is recoverable, and restore only from verified backups.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/LIFEBOAT/",
  "scope": "/LIFEBOAT/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#081226",
  "theme_color": "#081226",
  "categories": [
    "utilities",
    "productivity",
    "security"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "navigate-existing"
    ]
  },
  "icons": [
    {
      "src": "/LIFEBOAT/assets/branding/lifeboat-pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/LIFEBOAT/assets/branding/lifeboat-pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/LIFEBOAT/screenshots/lifeboat-mobile.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "LIFEBOAT mobile home screen"
    },
    {
      "src": "/LIFEBOAT/screenshots/lifeboat-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "LIFEBOAT desktop home screen"
    }
  ],
  "shortcuts": [
    {
      "name": "Prepare recovery",
      "short_name": "Prepare",
      "description": "Review owner-controlled recovery preparation guidance.",
      "url": "/LIFEBOAT/#prepare",
      "icons": [
        {
          "src": "/LIFEBOAT/assets/branding/lifeboat-pwa-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Safety and limits",
      "short_name": "Safety",
      "description": "Review LIFEBOAT privacy boundaries and recovery limitations.",
      "url": "/LIFEBOAT/#safety",
      "icons": [
        {
          "src": "/LIFEBOAT/assets/branding/lifeboat-pwa-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
